# Copy this file to ".env" and fill in the values, then run: npm start
# (.env is git-ignored — never commit real keys.)

# Protects the /admin dashboard and CSV export. Use a long random string.
ADMIN_TOKEN=change-me-to-something-secret

# --- Supabase (leave BOTH blank to use a local signups.db file instead) ---
# From Supabase dashboard → Project Settings → Data API / API keys.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Use the SERVICE ROLE key (secret). It is only ever used server-side.
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: port to listen on (default 3000).
# PORT=3000
